# Copy to .env. Everything is optional: with nothing set the pipeline still runs,
# the alert is written from a template and stored as a dry run.

# --- LLM: any OpenAI-compatible chat/completions endpoint ---
# Groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Ollama (no key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1
# LLM_REASONING_EFFORT=none   # for local thinking models (qwen, deepseek-r1): skip the reasoning phase

# --- Slack incoming webhook ---
SLACK_WEBHOOK_URL=

# --- Alert rule: notify only if the last 14 days hold an anomaly at or above this severity ---
# low | medium | high | critical
ALERT_MIN_SEVERITY=high
